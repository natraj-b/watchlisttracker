# Copy to .env for local dev, and set the same keys in Vercel → Project
# Settings → Environment Variables for production. Values come from Firebase
# Console → Project settings → Your apps → (your web app) → SDK setup.
#
# These are NOT secrets — Firebase web config is meant to be public; access
# control is enforced by Firestore security rules, not by hiding these values.
# Leaving all of these blank runs the app in local-only mode (no cloud sync).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
